// Web origin the apps talk to. Since the move to Neon everything is same-origin:
// the API is https://<host>/api/* and sign-in is the Neon Auth proxy at https://<host>/api/auth/*.
// Change this value (and nothing in Swift) when the domain moves.
//
// xcconfig treats "//" as a comment, so only the host is stored here; AppConfig builds the
// https URL. Nothing here is a secret.
// To override locally without committing, create Config/Backend.local.xcconfig (git-ignored).
TOKENY_WEB_HOST = tokeny.martinpohl.cz

#include? "Backend.local.xcconfig"
