# ── Frontend (Vite, public) ─────────────────────────────────────────────
# Show "Continue with Apple" once Apple is configured in Neon Auth.
# VITE_AUTH_APPLE_ENABLED=true

# ── Server (Vercel Function env; never commit real values) ─────────────
# Neon Postgres (project "tokeny"), pooled connection string
# DATABASE_URL=postgresql://...
# Neon Auth (Better Auth) base URL, e.g. https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
# NEON_AUTH_BASE_URL=
# ≥32 random chars, signs the session cache cookie
# NEON_AUTH_COOKIE_SECRET=
# 32 random bytes, base64 — encrypts provider API keys (AES-256-GCM)
# CREDENTIALS_ENCRYPTION_KEY=
# Bearer secret for /api/cron/daily (Vercel Cron sends it automatically)
# CRON_SECRET=
# APP_URL=https://tokeny.martinpohl.cz

# Optional

# Stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_PORTAL_CONFIGURATION=bpc_...   # Tokeny-branded customer portal (account default belongs to another product)
# STRIPE_TRIAL_DAYS=7
# STRIPE_WEBHOOK_SECRET=whsec_...   # endpoint: https://tokeny.martinpohl.cz/api/stripe-webhook
