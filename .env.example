# Supabase — get from project settings (Project Settings → API). Public values only.
# To switch the whole repo (also vercel.json, supabase/config.toml, Apple xcconfig) at once:
#   node scripts/set-backend.mjs <project-ref> <publishable-key>
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Supabase Edge Function secrets (set via: supabase secrets set KEY=value)
# ANTHROPIC_API_KEY=sk-ant-...
# RESEND_API_KEY=re_...
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...  (Supabase Auth → Hooks → Send Email hook secret)
# AUTO_SYNC_SECRET=...            (random 32+ chars; same value as Vault secret auto_sync_secret)
# APP_URL=https://tokeny.martinpohl.cz

# Stripe (Edge Function secrets)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_MONTHLY=price_...  (Pro monthly price)
# STRIPE_PRICE_YEARLY=price_...   (Pro yearly price)
# STRIPE_TRIAL_DAYS=14            (optional; trial for first-time subscribers)
# STRIPE_WEBHOOK_SECRET=whsec_... (from Stripe Dashboard → Webhooks)
